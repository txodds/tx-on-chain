{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "TxLINE Documentation",
  "landingPage": "documentation/quickstart",
  "colors": {
    "primary": "#FF5723",
    "light": "#FF5723",
    "dark": "#FF5723"
  },
  "favicon": "https://txodds.github.io/tx-on-chain/assets/logo/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "documentation/quickstart",
              "documentation/subscription-tiers",
              "documentation/faq"
            ]
          },
          {
            "group": "Odds",
            "pages": [
              "documentation/odds/overview",
              "documentation/odds/odds-fields",
              "documentation/odds/odds-coverage"
            ]
          },
          {
            "group": "Scores",
            "pages": [
              "documentation/scores/overview",
              "documentation/scores/schedule",
              "documentation/scores/soccer-feed",
              "documentation/scores/football-feed",
              "documentation/scores/basketball-feed"
            ]
          },
          {
            "group": "Solana Programs",
            "pages": [
              "documentation/programs/addresses",
              "documentation/programs/mainnet",
              "documentation/programs/devnet"
            ]
          },
          {
            "group": "Examples",
            "pages": [
              "documentation/examples/fetching-snapshots",
              "documentation/examples/streaming-data",
              "documentation/examples/booking-fixtures",
              "documentation/examples/onchain-validation",
              "documentation/examples/devnet-examples",
              "documentation/examples/troubleshooting"
            ]
          },
          {
            "group": "Legal",
            "pages": [
              "documentation/legal/terms-and-conditions"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "openapi": "https://txline.txodds.com/docs/docs.yaml",
        "groups": [
          {
            "group": "Using the API",
            "pages": [
              "documentation/api/introduction",
              "documentation/api/authentication",
              "documentation/api/time-and-batches",
              "documentation/api/fixture-lifecycle",
              "documentation/api/streaming",
              "documentation/api/errors"
            ]
          },
          {
            "group": "Access",
            "pages": [
              "POST /auth/guest/start",
              "POST /api/token/activate",
              "POST /api/guest/purchase/quote"
            ]
          },
          {
            "group": "Booking",
            "pages": [
              "GET /api/fixtures-schedule",
              "GET /api/quotes/book-fixture"
            ]
          },
          {
            "group": "Fixtures",
            "pages": [
              "GET /api/fixtures/snapshot",
              "GET /api/fixtures/updates/{epochDay}/{hourOfDay}"
            ]
          },
          {
            "group": "Odds",
            "pages": [
              "GET /api/odds/snapshot/{fixtureId}",
              "GET /api/odds/updates/{fixtureId}",
              "GET /api/odds/updates/{epochDay}/{hourOfDay}/{interval}"
            ]
          },
          {
            "group": "Scores",
            "pages": [
              "GET /api/scores/snapshot/{fixtureId}",
              "GET /api/scores/updates/{fixtureId}",
              "GET /api/scores/updates/{epochDay}/{hourOfDay}/{interval}",
              "GET /api/scores/historical/{fixtureId}"
            ]
          },
          {
            "group": "Streams",
            "pages": [
              "GET /api/odds/stream",
              "GET /api/scores/stream"
            ]
          },
          {
            "group": "Validation Proofs",
            "pages": [
              "GET /api/fixtures/validation",
              "GET /api/fixtures/batch-validation",
              "GET /api/odds/validation-v4",
              "GET /api/odds/validation",
              "GET /api/scores/stat-validation-v4"
            ]
          }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/documentation/quickstart"
    },
    {
      "source": "/quickstart",
      "destination": "/documentation/quickstart"
    },
    {
      "source": "/worldcup",
      "destination": "/documentation/subscription-tiers"
    },
    {
      "source": "/subscription-tiers",
      "destination": "/documentation/subscription-tiers"
    },
    {
      "source": "/scores/schedule",
      "destination": "/documentation/scores/schedule"
    },
    {
      "source": "/openapi.json",
      "destination": "/docs/docs.yaml"
    },
    {
      "source": "/api-reference/openapi.json",
      "destination": "/docs/docs.yaml"
    }
  ],
  "logo": {
    "light": "https://txodds.github.io/tx-on-chain/assets/logo/light.svg",
    "dark": "https://txodds.github.io/tx-on-chain/assets/logo/dark.svg"
  },
  "contextual": {
    "options": [
     "copy",
     "view",
     "chatgpt",
     "claude",
     "perplexity",
     "mcp",
     "cursor",
     "vscode"
   ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/txoddsofficial",
      "github": "https://github.com/txodds"
    }
  },
  "background": {
    "decoration": "grid"
  },
  "appearance": {
    "default": "system"
  }
}
